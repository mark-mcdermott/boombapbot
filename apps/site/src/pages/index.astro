---
import { Machine } from '../components/Machine';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base
  title="boombapbot · Let’s cook"
  description="A drum machine in your browser. Write rhythms on its sixteen step buttons, play them by hand or string them into a track, and export WAV, MIDI or a project file."
>
  <main class="min-h-dvh">
    <h1 class="sb-visually-hidden">boombapbot drum machine</h1>
    <Machine client:only="react" baseUrl={base}>
      <p slot="fallback" class="mx-auto max-w-[1180px] px-5 py-10 text-dim">Loading the machine…</p>
    </Machine>
    <noscript>
      <p class="mx-auto max-w-[1180px] px-5 py-10 text-dim">boombapbot needs JavaScript and Web Audio to run.</p>
    </noscript>
  </main>
</Base>
