---
import { BoombapbotEditor } from '@boombapbot/editor';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const title = 'boombapbot · make a beat';
const description =
  'A drums-only beat maker. Build a 16-step beat on four drum kits, save it in your browser, and export WAV, MIDI or a project file.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0d0c" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main class="min-h-dvh">
      <h1 class="sb-visually-hidden">boombapbot beat editor</h1>
      <BoombapbotEditor client:only="react" baseUrl={base}>
        <p slot="fallback" class="mx-auto max-w-[1180px] px-5 py-10 text-dim">Loading the editor…</p>
      </BoombapbotEditor>
      <noscript>
        <p class="mx-auto max-w-[1180px] px-5 py-10 text-dim">
          boombapbot needs JavaScript and Web Audio to run.
        </p>
      </noscript>
    </main>
    <footer class="mx-auto max-w-[1180px] px-5 pb-10 text-[12px] leading-relaxed text-faint">
      v0.1 preview. The four kits are synthesised placeholder sounds, not recordings of any hardware.
      Your beat is saved only in this browser; export the project file to keep a copy.
    </footer>
  </body>
</html>
