# boombapbot site: what accounts, the upgrade and the shop need.
#
# Copy this file to apps/site/.env and fill in the values. That file is
# ignored by git. Never put a value in this one.
#
# Accounts read the first five (and the optional one under Email). The shop
# reads the Stripe and Printful values; it stays closed without them.
# Use TEST keys for Stripe and a development database while building.

# ---- The site itself -------------------------------------------------------

# Where the site is served from, with no trailing slash. Sign-in cookies and
# the links in emails are built from it. `pnpm dev` ignores it and follows
# whatever address you opened, so the live value is fine here.
#   live: https://boombapbot.com
PUBLIC_SITE_URL=

# ---- Database: Neon ---------------------------------------------------------

# The pooled connection string of a Neon Postgres database, from the Neon
# console under Connection details. It starts with postgresql://
# A separate branch or database for development is safest. Create its
# tables with `pnpm db:migrate`.
# To try accounts with no database at all, use pglite:memory (forgotten when
# the server stops) or pglite:./.data/dev (kept in that folder).
DATABASE_URL=

# ---- Accounts: Better Auth --------------------------------------------------

# A long random secret that signs sessions. Make one with:
#   openssl rand -base64 32
# Use a different one for the live site.
BETTER_AUTH_SECRET=

# ---- Email: Resend ----------------------------------------------------------

# An API key from resend.com, under API keys. Sending access is enough.
RESEND_API_KEY=

# The address verification and password-reset mail comes from. Its domain has
# to be verified in Resend first.
#   example: boombapbot <noreply@boombapbot.com>
EMAIL_FROM=

# Optional. A folder: with this set, no email is sent and each message is
# written there as a file instead, so sign-up can be tried before a sending
# domain exists. Leave it out on the live site.
#   example: ./.data/outbox
EMAIL_OUTBOX=

# ---- Payments: Stripe -------------------------------------------------------

# From the Stripe dashboard, under Developers, API keys. This is the only
# Stripe value the shop needs to take an order. It starts with sk_test_ or
# sk_live_. A restricted key with write access to Checkout Sessions is
# enough, and safer for a live one.
STRIPE_SECRET_KEY=

# Not read by anything: payment happens on Stripe's own page. Leave it empty.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The signing secret of the webhook endpoint that tells the site a payment
# went through. It starts with whsec_.
#   local: printed by `stripe listen --forward-to localhost:4321/api/webhooks/stripe`
#   live:  from the endpoint added in the dashboard under Developers, Webhooks
STRIPE_WEBHOOK_SECRET=

# Optional. The one-time upgrade is closed, and its checkout refuses, until
# this is the word: on
# It also needs the two Stripe values above. Leave it empty until the
# Policies page covers the upgrade and its modal exists.
UPGRADE_OPEN=

# Optional. The secret half of the pair that license files are signed with:
# 32 bytes in base64url. Without it no license file is given out. Make the
# pair with `pnpm license:keypair`; the public half goes into the programs
# (see docs/license-file.md). Use a different pair for development, and never
# put the live one in a file.
LICENSE_SIGNING_KEY=

# ---- Merchandise: Printful --------------------------------------------------

# A private token from the Printful developer portal, for the boombapbot store
# only. Scopes: view and manage orders, view store products, view and manage
# store webhooks. `pnpm shop:sync` reads the products with it.
PRINTFUL_API_KEY=

# The id of the Printful store the products are in. Leave empty when the
# token is for one store.
PRINTFUL_STORE_ID=

# A long random string of your own. Printful's webhook address will carry it,
# so the site can tell a real shipping update from a forged one. Make one with:
#   openssl rand -hex 32
# Set the same value in Vercel and deploy, then `pnpm shop:webhook --register`
# gives Printful the address.
PRINTFUL_WEBHOOK_SECRET=
