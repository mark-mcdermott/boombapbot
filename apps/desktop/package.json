{
  "name": "@boombapbot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The desktop app: the shared editor with РИТМ-12 in a Tauri shell, playing through the engine built natively.",
  "scripts": {
    "assets": "node ../../scripts/copy-app-assets.mjs .",
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && vite build",
    "app": "tauri dev",
    "bundle": "tauri build",
    "test:engine": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:run": "tauri build --debug --no-bundle && BOOMBAPBOT_DESKTOP_CHECK=${BOOMBAPBOT_DESKTOP_CHECK:-play} src-tauri/target/debug/boombapbot-desktop",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@boombapbot/editor": "workspace:*",
    "@boombapbot/machine-ritm12": "workspace:*",
    "@fontsource-variable/sofia-sans-condensed": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
