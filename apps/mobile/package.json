{
  "name": "@boombapbot/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The phone apps: the shared editor with РИТМ-12 in a Capacitor shell for iOS and Android.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && vite build",
    "sync": "pnpm build && cap sync",
    "ios": "pnpm sync && cap run ios",
    "android": "pnpm sync && cap run android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@boombapbot/editor": "workspace:*",
    "@boombapbot/machine-ritm12": "workspace:*",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
