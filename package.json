{
  "name": "boombapbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "boombapbot: a drums-only beat maker. v0.1 web editor.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "setup:emsdk": "./scripts/setup-emsdk.sh",
    "build:engine": "./scripts/build-engine.sh",
    "build:wasm": "./scripts/build-wasm.sh",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && pnpm --filter @boombapbot/site dev",
    "build": "node scripts/prepare-assets.mjs && pnpm --filter @boombapbot/site build && node scripts/check-build.mjs",
    "preview": "pnpm --filter @boombapbot/site preview",
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p packages/editor && tsc --noEmit -p packages/machine-ritm12 && tsc --noEmit -p e2e && pnpm --filter @boombapbot/site check && pnpm --filter @boombapbot/mobile typecheck && pnpm --filter @boombapbot/desktop typecheck",
    "test": "pnpm test:engine && pnpm test:unit && pnpm test:e2e",
    "test:engine": "ctest --test-dir build/native --output-on-failure",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench-engine.mjs",
    "audition": "esbuild scripts/audition-effects.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build/audition.mjs && node build/audition.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "db:generate": "pnpm --filter @boombapbot/site db:generate",
    "db:migrate": "pnpm --filter @boombapbot/site db:migrate",
    "shop:sync": "node scripts/sync-shop.mjs",
    "shop:webhook": "node scripts/register-printful-webhook.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
